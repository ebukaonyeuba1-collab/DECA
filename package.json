{
  "name": "deca",
  "version": "0.1.0",
  "private": true,
  "description": "DECA professional services marketplace (Deca Ltd)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "psql \"$SUPABASE_DB_URL\" -f supabase/tests/10_smoke.sql",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:test:local": "bash scripts/test-db.sh",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@hookform/resolvers": "^7.0.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.1"
  }
}
